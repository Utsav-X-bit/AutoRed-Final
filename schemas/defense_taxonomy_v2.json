{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Defense Taxonomy v2",
  "type": "object",
  "properties": {
    "primary_type": {
      "type": "string",
      "enum": [
        "jailbreak_protection",
        "instruction_following",
        "authentication",
        "content_filtering",
        "roleplay",
        "format_enforcement",
        "unknown"
      ]
    },
    "access_code_type": {
      "type": "string",
      "enum": ["TOKEN", "PHRASE", "SENTENCE", "MULTILINE", "CONVERSATION", "UNKNOWN"]
    },
    "defense_complexity": {
      "type": "string",
      "enum": ["low", "medium", "hard"]
    }
  }
}
