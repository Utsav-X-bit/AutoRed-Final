{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoRed Run Artifact v2",
  "type": "object",
  "properties": {
    "experiment": {
      "type": "object",
      "properties": {
        "run_id": {"type": "string"},
        "benchmark_mode": {"type": "boolean"},
        "benchmark_run_number": {"type": "integer"},
        "benchmark_total_runs": {"type": "integer"},
        "max_attempts": {"type": "integer"},
        "dataset_size": {"type": "integer"},
        "scenario_id": {"type": "string"},
        "seed": {"type": "integer"},
        "timestamp": {"type": "string", "format": "date-time"},
        "experiment_version": {"type": "string"},
        "git_commit": {"type": "string"}
      }
    },
    "raw_dataset_entry": {
      "type": "object",
      "properties": {
        "defense_id": {"type": "string"},
        "opening_defense": {"type": "string"},
        "closing_defense": {"type": "string"},
        "access_code": {"type": "string"}
      }
    },
    "models": {"type": "object"},
    "timing": {"type": "object"},
    "ground_truth": {
      "type": "object",
      "properties": {
        "access_code": {"type": "string"},
        "leaked": {"type": "boolean"},
        "leak_position": {"type": ["integer", "null"]},
        "leak_count": {"type": "integer"}
      }
    },
    "best_attack": {
      "type": ["object", "null"],
      "properties": {
        "prompt": {"type": "string"},
        "score": {"type": "number"},
        "strategy": {"type": "string"}
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "$ref": "attempt_v2.schema.json"
      }
    },
    "events": {"type": "array"}
  }
}
